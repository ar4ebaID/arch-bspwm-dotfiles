#
# SYSTEM
#

# перезагрузить конфигурационные файлы sxhkd:
super + Escape
	pkill -USR1 -x sxhkd

# управление громкостью: тише
XF86AudioLowerVolume
	wpctl set-volume -l 1 @DEFAULT_SINK@ 2%-

# управление громкостью: громче
XF86AudioRaiseVolume
        wpctl set-volume -l 1 @DEFAULT_SINK@ 2%+

# управление громкостью: выключить звук
XF86AudioMute
        wpctl set-mute @DEFAULT_SINK@ toggle



#
# APPS
#

# Kitty 
super + Return
	kitty

# запуск программ
super + @space
	rofi -show drun

# запустить приложение shutter (для скриншотов)
F12
	shutter

# File manager
super + x
	thunar

# Firefox
super + c
	firefox

# Sublime Text
super + v
	subl


#
# BSPWM hotkeys
#

# выход/перезапуск bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# закрыть app
super + w
	bspc node -c

# установить состояние окна
super + {t,s,f}
	bspc node -t {tiled,floating,fullscreen}

# перевести фокус на узел в заданном направлении
super + {Left,Down,Up,Right}
	bspc node -f {west,south,north,east}

# перевести фокус или отправить на заданный рабочий стол
super + {1,2,3,4,5,6}
	bspc desktop -f {1,2,3,4,5,6}

super + shift + {1,2,3,4,5,6}
	bspc node -d {1,2,3,4,5,6}

#
# перемещение/изменение размера
#

# расширить окно, перемещая одну из его сторон наружу
super + alt + {Left,Down,Up,Right}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# сжать окно, перемещая одну из его сторон внутрь
super + ctrl + {Left,Down,Up,Right}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# переместить плавающее окно
super + shift + {Left,Down,Up,Right}
	bspc node -s {west,south,north,east,west,south,north,east} --follow